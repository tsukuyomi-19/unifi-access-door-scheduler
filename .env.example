CALENDAR_ID=
IMPERSONATED_USER_EMAIL=

# Email notifications (Gmail App Password)
EMAIL_SENDER=
EMAIL_PASSWORD=
SUCCESS_RECIPIENTS=
FAILURE_RECIPIENTS=
